# Intelligent Number Guessing Agent

low = 1
high = 100

print("Think of a number between 1 and 100.")
print("I will try to guess your number!")

while low <= high:

    guess = (low + high) // 2

    print("\nMy Guess is:", guess)
    feedback = input("Enter (higher/lower/correct): ").lower()

    if feedback == "correct":
        print("Number Guessed Successfully!")
        break

    elif feedback == "higher":
        low = guess + 1

    elif feedback == "lower":
        high = guess - 1

    else:
        print("Invalid Feedback! Try again.")

else:
    print("No valid number found!")
