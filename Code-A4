# Adversarial Search using Alpha-Beta Pruning

def alpha_beta(node, depth, alpha, beta, maximizing):
    if depth == 0 or isinstance(node, int):
        return node

    if maximizing:
        best = -float('inf')

        for child in node:
            value = alpha_beta(child, depth-1, alpha, beta, False)
            best = max(best, value)
            alpha = max(alpha, best)

            if beta <= alpha:
                break

        return best

    else:
        best = float('inf')

        for child in node:
            value = alpha_beta(child, depth-1, alpha, beta, True)
            best = min(best, value)
            beta = min(beta, best)

            if beta <= alpha:
                break

        return best


# Game Tree
tree = [
    [3, 5],
    [6, 9],
    [1, 2],
    [0, -1]
]

# Initial Values
alpha = -float('inf')
beta = float('inf')

result = alpha_beta(tree, 3, alpha, beta, True)

print("Optimal Value:", result)
