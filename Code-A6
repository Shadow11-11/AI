# Sudoku Solver using Backtracking and Constraint Propagation

# Initial Sudoku Puzzle (0 represents empty cell)
grid = [
    [5, 3, 0, 0, 7, 0, 0, 0, 0],
    [6, 0, 0, 1, 9, 5, 0, 0, 0],
    [0, 9, 8, 0, 0, 0, 0, 6, 0],
    [8, 0, 0, 0, 6, 0, 0, 0, 3],
    [4, 0, 0, 8, 0, 3, 0, 0, 1],
    [7, 0, 0, 0, 2, 0, 0, 0, 6],
    [0, 6, 0, 0, 0, 0, 2, 8, 0],
    [0, 0, 0, 4, 1, 9, 0, 0, 5],
    [0, 0, 0, 0, 8, 0, 0, 7, 9]
]


# Check Valid Number
def is_valid(grid, row, col, num):
    for i in range(9):
        if grid[row][i] == num or grid[i][col] == num:
            return False

    r = (row // 3) * 3
    c = (col // 3) * 3

    for i in range(r, r + 3):
        for j in range(c, c + 3):
            if grid[i][j] == num:
                return False

    return True


# Constraint Propagation
def propagate(grid):
    changed = True

    while changed:
        changed = False

        for i in range(9):
            for j in range(9):
                if grid[i][j] == 0:
                    possible = []

                    for num in range(1, 10):
                        if is_valid(grid, i, j, num):
                            possible.append(num)

                    if not possible:
                        return False

                    if len(possible) == 1:
                        grid[i][j] = possible[0]
                        changed = True

    return True


# Backtracking Algorithm
def solve(grid):
    if not propagate(grid):
        return False

    for i in range(9):
        for j in range(9):
            if grid[i][j] == 0:

                for num in range(1, 10):
                    if is_valid(grid, i, j, num):
                        new_grid = [row[:] for row in grid]
                        new_grid[i][j] = num

                        if solve(new_grid):
                            for r in range(9):
                                grid[r] = new_grid[r]
                            return True

                return False

    return True


# Print Sudoku
def print_grid(grid):
    for row in grid:
        print(row)


print("Initial Sudoku:")
print_grid(grid)

if solve(grid):
    print("\nSolved Sudoku:")
    print_grid(grid)
else:
    print("No Solution Found")
