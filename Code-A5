from collections import deque

# Check Valid Move
def is_valid_move(from_peg, to_peg):
    if not from_peg:
        return False
    if not to_peg:
        return True
    return from_peg[-1] < to_peg[-1]


# Generate Next States
def get_successors(state):
    successors = []
    pegs = ['A', 'B', 'C']

    for i in range(3):
        for j in range(3):
            if i != j and is_valid_move(state[i], state[j]):

                new_state = [list(peg) for peg in state]
                disk = new_state[i].pop()
                new_state[j].append(disk)

                new_state = tuple(tuple(peg) for peg in new_state)

                successors.append((new_state, pegs[i], pegs[j], disk))

    return successors


# BFS Algorithm
def solve_tower_of_hanoi(n):
    start = (tuple(range(n, 0, -1)), (), ())
    goal = ((), (), tuple(range(n, 0, -1)))

    queue = deque([(start, [])])
    visited = {start}

    while queue:
        state, path = queue.popleft()

        if state == goal:
            print("Solution Found in", len(path), "moves!")

            for move in path:
                print(move)

            return

        for new_state, src, dest, disk in get_successors(state):
            if new_state not in visited:
                visited.add(new_state)

                move = "Move Disk " + str(disk) + " from Peg " + src + " to Peg " + dest

                queue.append((new_state, path + [move]))

    print("No Solution Found")


# Main Program
N = 3

print("Tower of Hanoi using BFS")
solve_tower_of_hanoi(N)
