# 8-Queens Problem using Backtracking

N = 8
board = [[0 for _ in range(N)] for _ in range(N)]

# Check Safe Position
def is_safe(row, col):
    for i in range(row):
        if board[i][col] == 1:
            return False

        if col - (row - i) >= 0:
            if board[i][col - (row - i)] == 1:
                return False

        if col + (row - i) < N:
            if board[i][col + (row - i)] == 1:
                return False

    return True


# Backtracking Function
def solve(row):
    if row == N:
        return True

    for col in range(N):
        if is_safe(row, col):
            board[row][col] = 1

            if solve(row + 1):
                return True

            board[row][col] = 0

    return False


# Main Program
if solve(0):
    print("Solution Found:\n")

    for row in board:
        print(row)
else:
    print("No Solution Found")
