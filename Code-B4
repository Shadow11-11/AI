# Simple Chatbot using Rule-Based Approach

def chatbot(user_input):
    user_input = user_input.lower()

    # Greetings
    if "hello" in user_input or "hi" in user_input:
        return "Hello! How can I help you?"

    # Name
    elif "name" in user_input:
        return "I am a simple AI Chatbot."

    # Computer Engineering
    elif "computer" in user_input:
        return "Computer Engineering deals with hardware and software."

    # Artificial Intelligence
    elif "ai" in user_input or "artificial intelligence" in user_input:
        return "AI enables machines to perform tasks that require human intelligence."

    # Study and Exam
    elif "study" in user_input or "exam" in user_input:
        return "Prepare a study timetable and practice previous papers."

    # Python
    elif "python" in user_input:
        return "Python is widely used in AI, ML and Data Science."

    # Thank You
    elif "thank you" in user_input or "thanks" in user_input:
        return "You are welcome!"

    # Exit
    elif "bye" in user_input or "exit" in user_input:
        return "Goodbye! Have a nice day."

    # Unknown Input
    else:
        return "Sorry, I didn't understand your question."


# Main Program
print("================================")
print("       AI CHATBOT")
print("================================")
print("Type 'bye' to exit.\n")

while True:
    user_input = input("You: ")
    response = chatbot(user_input)

    print("Bot:", response)

    if user_input.lower() in ["bye", "exit"]:
        break
